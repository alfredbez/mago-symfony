{
    "name": "alfredbez/mago-symfony",
    "description": "Symfony support for the Mago static analyzer.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/alfredbez/mago-symfony",
    "keywords": ["mago", "symfony", "static-analysis", "extension", "php"],
    "authors": [
        {
            "name": "Alfred Bez",
            "homepage": "https://github.com/alfredbez"
        }
    ],
    "support": {
        "issues": "https://github.com/alfredbez/mago-symfony/issues",
        "source": "https://github.com/alfredbez/mago-symfony"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "carthage-software/mago": "~1.60.2"
    },
    "require-dev": {
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/form": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/messenger": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "symfony/serializer": "^6.4 || ^7.0",
        "symfony/validator": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "AlfredBez\\MagoSymfony\\": "src/"
        }
    },
    "bin": [
        "bin/mago-symfony-worker"
    ],
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": true
    }
}
